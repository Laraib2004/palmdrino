<resources>
    <!-- Compose renders the whole UI, so the platform theme only needs to stay
         out of the way: no ActionBar, no decor title. -->
    <style name="Theme.Palmdrino" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
